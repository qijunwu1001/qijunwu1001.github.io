---
const { className, title, id } = Astro.props;
---

<section id={id} data-scroll-section={id} class:list={["scroll-mt-8 flex flex-col gap-4 print:gap-0", className]}>
	{title && (
		<header data-section-heading={id} class="flex items-center border-b border-skin-muted/30 pb-2 print:border-b-0 print:pb-0">
			<h2 class="text-[22px] font-semibold leading-tight tracking-tight print:text-lg">{title}</h2>
		</header>
	)}
	<div class="flex flex-col gap-4 pl-4 sm:pl-5 print:pl-0">
		<slot />
	</div>
</section>

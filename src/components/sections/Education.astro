---
import Section from "../Section.astro";

const { education = [], certificates = [], title, certificateTitle, logoLabel = "logo" } = Astro.props;
---

<Section id="education" className={Astro.props.className} title={title}>
	<ul class="space-y-6 py-3 print:space-y-3">
		{
			education.map(({ institution, startDate, endDate, endDateExpected, displayPeriod, area, studyType, degree: displayDegree, url, logo, logoMode }) => {
				const formatMonth = (date: string) => date.slice(0, 7).replace("-", ".");
				const startMonth = startDate ? formatMonth(startDate) : "";
				const endMonth = endDate != null ? formatMonth(endDate) + (endDateExpected ? " (Expected)" : "") : startDate ? "Present" : "";
				const displayDate = displayPeriod ?? (startMonth ? startMonth + " – " + endMonth : "");
				const degree = displayDegree ?? [studyType, area].filter(Boolean).join(" in ");
				const logoSrc = logo && (logo.startsWith("http") ? logo : `${import.meta.env.BASE_URL}${logo.replace(/^\/+/, "")}`);

				return (
					<div class="flex items-center gap-4">
						{logoSrc ? (
							<div class:list={["flex h-16 w-16 shrink-0 items-center bg-white", logoMode === "crop-left" ? "justify-start overflow-hidden rounded-full" : "justify-center rounded-full"]}>
								<img
									src={logoSrc}
									alt={`${institution} ${logoLabel}`}
									class={logoMode === "crop-left" ? "h-full w-auto max-w-none object-contain object-left" : "h-full w-full rounded-full object-contain p-0.5"}
								/>
							</div>
						) : (
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 hidden h-5 w-5 self-start md:inline-block print:hidden">
								<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
								<path d="M22 10v6" />
								<path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
							</svg>
						)}
						<div class="relative min-w-0 flex-1 items-baseline justify-between gap-2">
							<h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 text-[17px] font-normal leading-snug">
								<a target="_blank" rel="noopener noreferrer" class="group flex items-center gap-[6px] underline decoration-dotted decoration-skin-muted/70 underline-offset-[5px] hover:decoration-solid" href={url}>
									{institution}
								</a>
							</h3>
							<div class="text-[13px] text-skin-muted">{degree}</div>
							{displayDate && <time class="right-0 top-0 text-[13px] text-skin-muted lg:absolute lg:block">{displayDate}</time>}
						</div>
					</div>
				);
			})
		}
	</ul>

	{
		certificates.length > 0 && (
			<>
				<h4>{certificateTitle}</h4>
				<ul class="space-y-4 py-3 print:space-y-0">
					{certificates.map(({ name, date, issuer, url }) => {
						const certificateMonth = date.slice(0, 7).replace("-", ".");
						return (
							<div class="flex items-baseline">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 hidden h-5 w-5 self-start md:inline-block print:hidden">
									<path d="M15 12h-5" />
									<path d="M15 8h-5" />
									<path d="M19 17V5a2 2 0 0 0-2-2H4" />
									<path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3" />
								</svg>
								<div class="relative w-full items-baseline justify-between gap-2">
									<h3 class="mr-6 items-baseline gap-x-2 gap-y-0.5 font-medium">
										<a class="hover:text-skin-hue group flex items-center gap-[6px] text-skin-base decoration-dotted underline-offset-[5px] hover:underline" href={url} target="_blank">
											{name}
										</a>
									</h3>
									<div class="text-[13px] text-skin-muted">{issuer}</div>
									<time class="right-0 top-0 text-[11px] text-skin-muted md:absolute md:block">{certificateMonth}</time>
								</div>
							</div>
						);
					})}
				</ul>
			</>
		)
	}
</Section>

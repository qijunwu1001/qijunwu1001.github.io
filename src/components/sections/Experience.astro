---
import Section from "../Section.astro";
const { work = [], title } = Astro.props;
---

<Section id="research" className={Astro.props.className} title={title}>
	<ul class="-ml-4 flex list-disc flex-col gap-6 pl-4 sm:-ml-5 sm:pl-5">
		{work.map(({ name, summary, responsibilities }) => (
			<li>
				<div class="flex flex-col gap-2">
					<h3 class="text-[17px] font-normal leading-snug print:text-[13px]">
						{name}
					</h3>
					<div class="mt-1 flex flex-col gap-2 pl-3">
						{summary && <p class="max-w-[72ch] text-[15px] leading-6 text-skin-muted">{summary}</p>}
					{responsibilities?.length && (
							<div class="flex max-w-[72ch] flex-col gap-1 text-[15px] leading-6 text-skin-muted print:text-xs print:leading-5">
								{responsibilities?.map((item) => <p>{item}</p>)}
							</div>
					)}
					</div>
				</div>
			</li>
		))}
	</ul>
</Section>

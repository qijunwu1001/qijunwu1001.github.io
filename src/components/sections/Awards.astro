---
import Section from "../Section.astro";
const { awards = [], title } = Astro.props;
---

{awards.length > 0 && (
	<Section id="awards" title={title}>
		<ul class="-ml-4 flex list-disc flex-col gap-4 pl-4 sm:-ml-5 sm:pl-5 print:gap-2">
			{awards.map(({ title, date, awarder, summary }) => (
				<li>
					<div class="flex items-start justify-between gap-4 pl-3">
						<div>
							<h3 class="text-[17px] font-normal leading-snug text-skin-base">{title}</h3>
							{awarder && <p class="mt-1 text-[15px] text-skin-muted">{awarder}</p>}
							{summary && <p class="mt-1 text-[11px] text-skin-muted">{summary}</p>}
						</div>
						<time class="shrink-0 text-[13px] text-skin-muted">{date}</time>
					</div>
				</li>
			))}
		</ul>
	</Section>
)}

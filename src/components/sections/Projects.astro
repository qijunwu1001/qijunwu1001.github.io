---
import Arrow from "@/icons/Arrow.astro";
import Section from "../Section.astro";
const { projects = [], title, viewLabel } = Astro.props;
---

<Section id="projects" className={Astro.props.className} title={title}>
	<ul class="flex flex-col gap-3">
		{projects.map(({ url, name, image }) => (
			<li>
				<article class="flex items-center gap-4 rounded-xl border border-skin-muted/40 bg-skin-button-muted/70 p-4">
					{image && <img src={`${import.meta.env.BASE_URL}${image}`} alt="" class="h-14 w-14 shrink-0 object-contain grayscale" loading="lazy" />}
					<h3 class="min-w-0 text-[18px] font-semibold leading-snug text-skin-base">
						{url ? (
							<a class="group inline-flex items-center gap-2 underline decoration-dotted decoration-skin-muted/70 underline-offset-4 hover:decoration-solid" href={url} title={`${viewLabel}: ${name}`} target="_blank" rel="noopener noreferrer">
								{name}
								<span class="text-current transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"><Arrow /></span>
							</a>
						) : name}
					</h3>
				</article>
			</li>
		))}
	</ul>
</Section>
